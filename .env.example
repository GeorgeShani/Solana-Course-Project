# Copy to .env (git-ignored) and fill in. Production runs on Solana mainnet.

# Public domain pointing at this host (an A record to the EC2 Elastic IP).
DOMAIN=relay.example.com

# A dedicated Solana mainnet RPC provider URL, including its key (for example Helius).
# Server-side only: the browser reaches Solana through /api/rpc, so this is never sent to clients.
# The server refuses the public https://api.mainnet-beta.solana.com endpoint in production.
SOLANA_RPC_URL=

# Bundled Postgres (only reachable inside the Compose network). Use a long random value.
POSTGRES_PASSWORD=

# Or an external database instead of the bundled one (then leave POSTGRES_PASSWORD empty and start
# only app, server and caddy). With a pooled URL, also set the direct one for migrations.
# DATABASE_URL=
# DATABASE_DIRECT_URL=

# Jupiter API key from the Jupiter developer platform (server-side only). Strongly recommended:
# without one the keyless tier is 0.5 requests/second for quotes and prices together.
JUPITER_API_KEY=
