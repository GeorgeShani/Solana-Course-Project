# Copy to .env (git-ignored) and edit.

# Public domain pointing at this host. Use "localhost" for a local test.
DOMAIN=localhost

# Solana RPC endpoint the browser and the SSR server use.
# Baked into the client bundle at build time, so it is public: do not put a
# secret key in it.
VITE_RPC_URL=https://api.devnet.solana.com

# Password for the Postgres container (the database is only reachable inside the Compose network).
POSTGRES_PASSWORD=change-me

# Which cluster the server reads: localnet (a Surfpool fork), devnet or mainnet.
SOLANA_CLUSTER=devnet

# Optional. The server's own RPC endpoint; defaults to VITE_RPC_URL. Unlike VITE_RPC_URL this is
# never sent to the browser, so a keyed provider URL is safe here.
# SOLANA_RPC_URL=

# Optional Jupiter API key (server-side only). Without one the keyless 0.5 req/s tier applies.
# JUPITER_API_KEY=
