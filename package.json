{
  "name": "solana-course-project",
  "private": true,
  "workspaces": [
    "app",
    "server",
    "domain"
  ],
  "scripts": {
    "dev:app": "bun run --cwd app dev",
    "dev:server": "bun run --hot --env-file=.env server/src/index.ts",
    "build:app": "bun run --cwd app build",
    "sync-idl": "bun run scripts/sync-idl.ts",
    "program:build": "bun run scripts/anchor.ts build",
    "program:build:devnet": "bun run scripts/anchor.ts build -- --features devnet",
    "program:test": "bun run scripts/anchor.ts test",
    "program:deploy": "bun run scripts/anchor.ts deploy",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "lint": "bunx oxlint -c .oxlintrc.json app domain server scripts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.2"
  }
}
